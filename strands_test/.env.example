# ── Google AI ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Model Configuration ───────────────────────────────────────────────────────
MODEL_NAME=gemini-2.5-flash

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── python_repl ───────────────────────────────────────────────────────────────
# Skip the manual confirmation prompt so the pipeline runs fully automated
BYPASS_TOOL_CONSENT=true
# Run in non-interactive (standard exec) mode
PYTHON_REPL_INTERACTIVE=false
