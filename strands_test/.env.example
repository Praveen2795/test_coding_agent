# ── Google AI ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Model Configuration ───────────────────────────────────────────────────────
MODEL_NAME=gemini-2.5-flash

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Data source (filename relative to repo root, or absolute path) ────────────
DATA_FILE=Consumer_Account_Tag.xlsx

# ── API ───────────────────────────────────────────────────────────────────────
API_BASE=http://127.0.0.1:8000

# ── python_repl ───────────────────────────────────────────────────────────────
# Skip the manual confirmation prompt so the pipeline runs fully automated
BYPASS_TOOL_CONSENT=true
# Run in non-interactive (standard exec) mode
PYTHON_REPL_INTERACTIVE=false
